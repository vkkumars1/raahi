NODE_ENV=development
PORT=4000

# Neon (or any Postgres with PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raahi

# Upstash (rediss://...) or local redis. Leave empty to use in-memory store (dev only)
REDIS_URL=

# Long random strings: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me
OTP_PEPPER=change-me-too-change-me-too

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000,https://raahi-ashy.vercel.app

# SMTP (Brevo / Gmail app password). If empty in dev, OTP is printed in the server log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Raahi <no-reply@example.com>"

# FastAPI service (leave empty to disable the assistant)
AI_SERVICE_URL=

CAB_RATE_PER_KM=20
